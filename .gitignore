# ============================================================
# GCP Bot — .gitignore
# ============================================================

# --- CRITICAL: Never commit credentials ---
.env
.env.local
.env.production
auth/service_account.json
auth/*.json
*.json
!package.json
!package-lock.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg

# --- Virtual environments ---
venv/
.venv/
env/
.env/
ENV/

# --- IDE & OS ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- APScheduler jobstore (if persisted to disk) ---
jobs.sqlite
