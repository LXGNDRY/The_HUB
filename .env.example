# ───────────────────────────────────────────────────────────
# GCP Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ───────────────────────────────────────────────────────────

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_PATH=auth/service_account.json

# Theme Deployment Agent
THEME_BUCKET=legendary-branding-themes

# Shopify (for live push to store)
SHOPIFY_STORE=yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# Billing Agent
BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX
BUDGET_THRESHOLD=100.0
SPIKE_THRESHOLD_PCT=20.0

# BigQuery Billing Export (optional — enables spend reports + spike detection)
BQ_BILLING_DATASET=billing_export
BQ_BILLING_TABLE=gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX

# Scheduler
DEFAULT_VM_ZONE=us-central1-a

# Notifications (Discord or Slack webhook URL)
DEPLOY_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook
