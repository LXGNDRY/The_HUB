# ============================================================
# The HUB — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Google Cloud ---
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=auth/service_account.json

# Comma-separated list of zones to monitor
GCP_ZONES=us-central1-a,us-central1-b

# --- Web Dashboard Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_API_KEY=replace-with-a-strong-random-key

# --- Automation Thresholds ---
BUDGET_THRESHOLD=100.00           # Alert if monthly spend exceeds this (USD)
IDLE_CPU_THRESHOLD=2.0            # Stop VMs below this avg CPU % (nightly job)
SNAPSHOT_MAX_AGE_DAYS=30         # Delete snapshots older than this
QUOTA_ALERT_PERCENT=80.0          # Alert if quota usage exceeds this %
STORAGE_INACTIVE_DAYS=90          # Flag buckets with no access in this many days

# --- Safety ---
# Set to true during development to log actions without executing them
DRY_RUN=false

# --- Shopify App / OAuth ---
# Public URL of your Cloud Run service (no trailing slash)
APP_URL=https://gcp-bot-xxxxxxxx-uc.a.run.app
# Webhook HMAC secret — copy from Shopify Admin → Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_REDIRECT_URI=https://legendary-branding.com/api/auth/shopify/callback

# --- Klaviyo ---
KLAVIYO_API_KEY=pk_...

# --- Gemini AI ---
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Notification Channels (configure at least one) ---
# Discord: Server Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Slack: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Telegram: Create bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# hub-backend (new SaaS backend, app/) — separate Cloud Run service
# ============================================================

# --- App ---
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,https://legendary-branding.com

# --- Database (Cloud SQL PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://hub_user:password@localhost:5432/the_hub

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CORE=price_core_99
STRIPE_PRICE_GROWTH=price_growth_249
STRIPE_PRICE_ENTERPRISE=price_enterprise_499
STRIPE_PRICE_AGENCY=price_agency_999

# --- Domain ---
DOMAIN=legendary-branding.com
DASHBOARD_URL=https://legendary-branding.com
